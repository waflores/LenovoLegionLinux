load("@rules_foreign_cc//foreign_cc:defs.bzl", "make")

filegroup(
    name = "legion-laptop-srcs",
    srcs = [
        "legion-laptop.c",
    ],
)

# KSRC
make(
    name = "kernel_module",
    args = ["KSRC=\"$EXT_BUILD_ROOT/$(dirname $(location @linux_kernel//:top_of_tree))\""],
    build_data = [
        "@linux_kernel//:include",
        "Makefile",
        "@linux_kernel//:srcs",
        "@linux_kernel//:top_of_tree",
    ],
    lib_source = ":legion-laptop-srcs",
    out_binaries = ["legion-laptop.ko"],
)
